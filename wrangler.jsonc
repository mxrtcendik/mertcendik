{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "mertcendik",
	"compatibility_date": "2026-06-25",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mertcendik"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "mertcendik-next-cache"
		}
	],
	"d1_databases": [
		{
			"binding": "VIEWS_DB",
			"database_name": "mertcendik-views",
			"database_id": "d1008db5-bb4a-4811-a506-e9bf7872f142",
			"migrations_dir": "migrations"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}